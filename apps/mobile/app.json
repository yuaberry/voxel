{
  "expo": {
    "name": "VOXEL",
    "slug": "voxel",
    "scheme": "voxel",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050609",
    "splash": {
      "backgroundColor": "#050609"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.yuadevs.voxel.mobile"
    },
    "android": {
      "package": "dev.yuadevs.voxel.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    }
  }
}