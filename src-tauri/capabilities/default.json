{
  "identifier": "default",
  "description": "VOXEL default capabilities — least privilege set for Phase 0",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://openrouter.ai/*"
        },
        {
          "url": "https://api.openai.com/*"
        },
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "https://launchermeta.mojang.com/*"
        },
        {
          "url": "https://piston-meta.mojang.com/*"
        },
        {
          "url": "https://meta.fabricmc.net/*"
        },
        {
          "url": "https://maven.fabricmc.net/*"
        },
        {
          "url": "https://maven.neoforged.net/*"
        },
        {
          "url": "https://files.minecraftforge.net/*"
        },
        {
          "url": "https://maven.minecraftforge.net/*"
        },
        {
          "url": "https://api.papermc.io/*"
        },
        {
          "url": "https://login.microsoftonline.com/*"
        },
        {
          "url": "https://user.auth.xboxlive.com/*"
        },
        {
          "url": "https://xsts.auth.xboxlive.com/*"
        },
        {
          "url": "https://api.minecraftservices.com/*"
        },
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://api.github.com/*"
        }
      ]
    },
    "notification:default"
  ]
}